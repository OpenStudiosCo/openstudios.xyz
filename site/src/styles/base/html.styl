html {
    font-size: 100%;
}

@media screen and (min-width: 1600px) {
    html {
        font-size: 112.5%;
    }
}

@media screen and (min-width: 2000px) {
    html {
        font-size: 125%;
    }
}

@media screen and (min-width: 2560px) {
    html {
        font-size: 137.5%;
    }
}

@media screen and (min-width: 3200px) {
    html {
        font-size: 162.5%;
    }
}

body {
    margin: 0;
    padding: 0;
    font-family: SourceSans, Arial, sans-serif;
    font-size: 1.125rem;
    line-height: 1.6;
    background-color: #000;
    color: #fff;
}

a {
    color: #00eeff;
}

h3 {
    font-family: VeraMono, Verdana, Geneva, Tahoma, sans-serif;
    font-size: 1.5rem;
    line-height: 1.35;
    color: #ff69cb;
    margin: 1.5rem 0;
}

p {
    line-height: 1.6;
}

form {
    border: 2px dotted #ff69cb;
    border-radius: 0.75rem;
    margin: 2rem 0;
    padding: 1.5rem;
}

form button,
form textarea,
form input {
    width: calc(100% - 2rem);
    margin: 0.75rem 0rem 1rem;
    padding: 1rem;
    border-radius: 0.75rem;
    border: solid 1px #ff69cb;
    background: none transparent;
    color: #ffffff;
}

form button {
    border-color: #00eeff;
    text-transform: uppercase;
    width: 100%;
}

form button:hover {
    background: #0099aa;
    cursor: pointer;
}

.hide-overflow {
    overflow: hidden;
}
