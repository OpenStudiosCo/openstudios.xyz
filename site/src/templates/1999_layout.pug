#page-wrapper
    a.skip-link(href='#main') Skip to content
    .header_bg
    header.header
        if ! isIframe
            .h1
                a(href='/' title='Home')
                    img(src='/assets/images/logo-wide.png' alt='Open Studios')
        else
            .h1
                a(title='Home')
                    img(src='/assets/images/logo-wide.png' alt='Open Studios')
    if ! isIframe
        nav.menu(aria-label='Main')
            ul
                li
                    a(href='/worlds.html') Worlds
                li
                    a(href='/the_studio.html') The Studio
                li
                    a(href='/what_we_do.html') What We Do
                li
                    a(href='/about_us.html') About Us
                li
                    a(href='/support_us.html') Support Us
        #pokematrix
            canvas#pokematrixCanvas
            canvas#pokematrixImage
            button#pokematrixSign(type='button')
                img(src='/assets/go3d.svg' title='Enter the virtual 3D office' width='300' height='85' alt='A sign saying to go 3D')
        include ../templates/exit_image.pug
        include ../templates/exit_image_mobile.pug
    if page.url == '/about_us.html'
        - extra_class = ' bg_river'
    else if page.url == '/404.html'
        - extra_class = ' bg_river'
    else if page.url == '/worlds.html'
        - extra_class = ' bg_reverse'
    else if page.url == '/the_studio.html'
        - extra_class = ' bg_reverse'
    else 
        - extra_class = ''
    main.content_row#main(class=extra_class)
        block page
    
    if page.url == '/about_us.html' || page.url == '/worlds.html' || page.url.indexOf('blog') >= 0
        aside.content_row.newsletter
            .newsletter_bg
            .content
                .row
                    .tiles
                        .tile
                            .tile_content
                            .tile_innercontent
                                include ../content/blocks/list_behind_the_scenes.pug
                        .tile
                            .tile_content
                            .tile_innercontent
                                include ../content/blocks/tile_support_us.pug
    include ./footer.pug