mixin blogMenu(active)
  nav.menu(aria-label='Blog')
    ul
      li
        if active === 'guides'
          span(aria-current='page') Guides
        else
          a(href='/blog/guides.html') Guides
      li
        if active === 'retrospectives'
          span(aria-current='page') Retrospectives
        else
          a(href='/blog/retrospectives.html') Retrospectives
    ul
      li
        if active === 'recent'
          span(aria-current='page') Recent articles
        else
          a(href='/blog.html') Recent articles
      li
        if active === '2026'
          span(aria-current='page') 2026
        else
          a(href='/blog/2026.html') 2026
      li
        if active === '2025'
          span(aria-current='page') 2025
        else
          a(href='/blog/2025.html') 2025
      li
        if active === '2024'
          span(aria-current='page') 2024
        else
          a(href='/blog/2024.html') 2024
      li
        if active === '2023'
          span(aria-current='page') 2023
        else
          a(href='/blog/2023.html') 2023
